{
  "name": "@2bad/bitrix",
  "version": "3.0.0-beta.0",
  "description": "Bitrix24 REST API client that doesn't suck",
  "keywords": [
    "api",
    "rest",
    "client",
    "rest-client",
    "api-client",
    "bx24",
    "bitrix",
    "bitrix24",
    "typescript"
  ],
  "homepage": "https://github.com/2BAD/bitrix#readme",
  "bugs": {
    "url": "https://github.com/2BAD/bitrix/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/2BAD/bitrix.git"
  },
  "license": "MIT",
  "author": "2BAD (https://github.com/2BAD)",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./build/bitrix.d.ts",
        "default": "./build/bitrix.js"
      }
    }
  },
  "files": [
    "build"
  ],
  "scripts": {
    "build": "tsdown",
    "check": "run-p check:**",
    "check:code": "oxlint ./source",
    "check:format": "oxfmt --check ./source",
    "check:types": "tsc --noEmit",
    "fix": "run-p fix:**",
    "fix:code": "oxlint --fix ./source",
    "fix:format": "oxfmt ./source",
    "prepublishOnly": "run-s build",
    "preversion": "run-s check test:unit build",
    "test": "vitest run",
    "test:integration": "vitest run integration --coverage",
    "test:unit": "vitest run unit --coverage"
  },
  "dependencies": {
    "@types/lodash.chunk": "4.2.9",
    "@types/lodash.frompairs": "4.0.9",
    "@types/lodash.range": "3.2.9",
    "@types/qs": "6.15.1",
    "got": "14.6.6",
    "lodash.chunk": "4.2.0",
    "lodash.frompairs": "4.0.1",
    "lodash.range": "3.2.0",
    "p-queue": "8.1.1",
    "qs": "6.15.3"
  },
  "devDependencies": {
    "@2bad/axiom": "2.1.0",
    "@2bad/tsconfig": "4.0.0",
    "@arethetypeswrong/cli": "0.18.5",
    "@types/node": "26.1.2",
    "@vitest/coverage-v8": "4.1.10",
    "nock": "13.5.6",
    "npm-run-all2": "9.0.3",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "publint": "0.3.22",
    "tsdown": "0.22.14",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  },
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=26"
  },
  "volta": {
    "node": "26.5.1",
    "pnpm": "11.18.0"
  }
}
